FROM python:3.11-slim

WORKDIR /app

# Install core dependencies (no heavy ML libs by default; mount trained models separately)
COPY requirements-producer.txt .
RUN pip install --no-cache-dir \
    numpy pandas scikit-learn joblib scipy jsonschema \
    fastapi "uvicorn[standard]" pydantic

# Copy source
COPY src/ ./src/

# Expose API port
EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
